(defun json-esc (s / i len ch out)
  (if (not s)
    ""
    (progn
      (setq i 1 len (strlen s) out "")
      (while (<= i len)
        (setq ch (substr s i 1))
        (cond
          ((= ch "\\") (setq out (strcat out "\\\\")))
          ((= ch "\"") (setq out (strcat out "\\\"")))
          ((= ch "\n") (setq out (strcat out "\\n")))
          ((= ch "\r") (setq out (strcat out "\\r")))
          ((= ch "\t") (setq out (strcat out "\\t")))
          ((< (ascii ch) 32) (setq out (strcat out " ")))
          (t (setq out (strcat out ch)))
        )
        (setq i (1+ i))
      )
      out
    )
  )
)

(defun num-str (n)
  (if (numberp n)
    (rtos n 2 6)
    "0"
  )
)

(defun pt-json (pt)
  (if (and pt (listp pt))
    (if (caddr pt)
      (strcat "[" (num-str (car pt)) "," (num-str (cadr pt)) "," (num-str (caddr pt)) "]")
      (strcat "[" (num-str (car pt)) "," (num-str (cadr pt)) "]")
    )
    "null"
  )
)

(defun dxf (code ed)
  (cdr (assoc code ed))
)

(defun dxf-def (code ed def)
  (if (assoc code ed) (cdr (assoc code ed)) def)
)

(defun mtext-full-str (ed / s item)
  (setq s "")
  (foreach item ed
    (if (or (= (car item) 3) (= (car item) 1))
      (setq s (strcat s (cdr item)))
    )
  )
  s
)

(defun lwpoly-wcs-verts-json (en ed / elev s first item rest b pt wpt)
  (setq elev (dxf-def 38 ed 0.0)
        s "["
        first T)
  (while ed
    (setq item (car ed))
    (if (= (car item) 10)
      (progn
        (setq b 0.0
              rest (cdr ed))
        (while (and rest (/= (caar rest) 10))
          (if (= (caar rest) 42) (setq b (cdar rest)))
          (setq rest (cdr rest))
        )
        (setq pt (list (cadr item) (caddr item) elev)
              wpt (trans pt en 0))
        (if (not first) (setq s (strcat s ",")))
        (setq first nil)
        (setq s (strcat s "[" (num-str (car wpt)) "," (num-str (cadr wpt)) "," (num-str (caddr wpt)) "," (num-str b) "]"))
      )
    )
    (setq ed (cdr ed))
  )
  (strcat s "]")
)

(defun poly-wcs-verts-json (en / nxt ed vstr first pt wpt b)
  (setq vstr "[" first T nxt (entnext en))
  (while (and nxt (setq ed (entget nxt)) (/= (dxf 0 ed) "SEQEND"))
    (if (= (dxf 0 ed) "VERTEX")
      (progn
        (setq pt (dxf 10 ed)
              wpt (trans pt en 0)
              b (dxf-def 42 ed 0.0))
        (if (not first) (setq vstr (strcat vstr ",")))
        (setq first nil)
        (setq vstr (strcat vstr "[" (num-str (car wpt)) "," (num-str (cadr wpt)) "," (num-str (caddr wpt)) "," (num-str b) "]"))
      )
    )
    (setq nxt (entnext nxt))
  )
  (strcat vstr "]")
)

(defun multi-pt-json (code ed / s first item)
  (setq s "[" first T)
  (foreach item ed
    (if (= (car item) code)
      (progn
        (if (not first) (setq s (strcat s ",")))
        (setq first nil)
        (setq s (strcat s (pt-json (cdr item))))
      )
    )
  )
  (strcat s "]")
)

(defun insert-attribs-json (en ed / s first nxt aed)
  (if (= (dxf-def 66 ed 0) 1)
    (progn
      (setq s "[" first T nxt (entnext en))
      (while (and nxt (setq aed (entget nxt)) (/= (dxf 0 aed) "SEQEND"))
        (if (= (dxf 0 aed) "ATTRIB")
          (progn
            (if (not first) (setq s (strcat s ",")))
            (setq first nil)
            (setq s (strcat s "{\"tag\":\"" (json-esc (dxf-def 2 aed ""))
                            "\",\"value\":\"" (json-esc (dxf-def 1 aed ""))
                            "\",\"pos\":" (pt-json (trans (dxf 10 aed) nxt 0)) "}"))
          )
        )
        (setq nxt (entnext nxt))
      )
      (strcat s "]")
    )
    "[]"
  )
)

(defun prim-entity-json (en / ed etyp cen rad sa ea p1 p2)
  (setq ed (entget en)
        etyp (dxf 0 ed))
  (cond
    ((= etyp "LINE")
      (strcat "{\"type\":\"LINE\",\"layer\":\"" (json-esc (dxf-def 8 ed "0"))
              "\",\"color\":" (itoa (dxf-def 62 ed 256))
              ",\"start\":" (pt-json (dxf 10 ed))
              ",\"end\":" (pt-json (dxf 11 ed)) "}"))
    ((= etyp "LWPOLYLINE")
      (strcat "{\"type\":\"LWPOLYLINE\",\"layer\":\"" (json-esc (dxf-def 8 ed "0"))
              "\",\"closed\":" (if (= (logand (dxf-def 70 ed 0) 1) 1) "true" "false")
              ",\"vertices\":" (lwpoly-wcs-verts-json en ed) "}"))
    ((= etyp "POLYLINE")
      (strcat "{\"type\":\"POLYLINE\",\"layer\":\"" (json-esc (dxf-def 8 ed "0"))
              "\",\"closed\":" (if (= (logand (dxf-def 70 ed 0) 1) 1) "true" "false")
              ",\"vertices\":" (poly-wcs-verts-json en) "}"))
    ((= etyp "CIRCLE")
      (setq cen (trans (dxf 10 ed) en 0)
            rad (dxf 40 ed))
      (strcat "{\"type\":\"CIRCLE\",\"center\":" (pt-json cen) ",\"radius\":" (num-str rad) "}"))
    ((= etyp "ARC")
      (setq cen (trans (dxf 10 ed) en 0)
            rad (dxf 40 ed)
            sa (dxf 50 ed)
            ea (dxf 51 ed)
            p1 (trans (polar (dxf 10 ed) sa rad) en 0)
            p2 (trans (polar (dxf 10 ed) ea rad) en 0))
      (strcat "{\"type\":\"ARC\",\"center\":" (pt-json cen)
              ",\"radius\":" (num-str rad)
              ",\"startAngle\":" (num-str sa)
              ",\"endAngle\":" (num-str ea)
              ",\"start\":" (pt-json p1)
              ",\"end\":" (pt-json p2) "}"))
    ((or (= etyp "TEXT") (= etyp "MTEXT"))
      (strcat "{\"type\":\"" etyp "\",\"text\":\""
              (json-esc (if (= etyp "MTEXT") (mtext-full-str ed) (dxf-def 1 ed "")))
              "\",\"pos\":" (pt-json (if (= etyp "MTEXT") (dxf 10 ed) (trans (dxf 10 ed) en 0)))
              ",\"rotation\":" (num-str (dxf-def 50 ed 0.0)) "}"))
    ((= etyp "INSERT")
      (strcat "{\"type\":\"INSERT\",\"name\":\"" (json-esc (dxf-def 2 ed ""))
              "\",\"pos\":" (pt-json (trans (dxf 10 ed) en 0))
              ",\"ocsPos\":" (pt-json (dxf 10 ed))
              ",\"scale\":[" (num-str (dxf-def 41 ed 1.0)) "," (num-str (dxf-def 42 ed 1.0)) "," (num-str (dxf-def 43 ed 1.0)) "]"
              ",\"rotation\":" (num-str (dxf-def 50 ed 0.0))
              ",\"normal\":" (pt-json (dxf-def 210 ed '(0.0 0.0 1.0))) "}"))
    ((= etyp "SOLID")
      (strcat "{\"type\":\"SOLID\",\"pts\":["
              (pt-json (trans (dxf 10 ed) en 0)) ","
              (pt-json (trans (dxf 11 ed) en 0)) ","
              (pt-json (trans (dxf 12 ed) en 0)) ","
              (pt-json (trans (dxf 13 ed) en 0)) "]}"))
    (t
      (strcat "{\"type\":\"" (json-esc etyp) "\"}"))
  )
)

(defun export-raw-entities (outpath / fp lfirst ltbl ss cnt i en ed hdl etyp lay col tcol ltyp cen rad sa ea p1 p2 bfirst btbl bname bhead bed cur subfirst)
  (setq fp (open outpath "w" "utf8"))
  (if (not fp) (setq fp (open outpath "w")))

  (write-line "{" fp)
  ;; 1. Layers
  (write-line "  \"layers\": [" fp)
  (setq lfirst T
        ltbl (tblnext "LAYER" T))
  (while ltbl
    (if (not lfirst) (write-line "," fp))
    (setq lfirst nil)
    (princ
      (strcat "    {\"name\":\"" (json-esc (dxf 2 ltbl))
              "\",\"color\":" (itoa (dxf 62 ltbl))
              ",\"linetype\":\"" (json-esc (dxf 6 ltbl))
              "\",\"flags\":" (itoa (dxf 70 ltbl)) "}")
      fp)
    (setq ltbl (tblnext "LAYER"))
  )
  (write-line "" fp)
  (write-line "  ]," fp)

  ;; 2. Entities in ModelSpace
  (setq ss (ssget "_X" '((410 . "Model"))))
  (setq cnt (if ss (sslength ss) 0))
  (write-line (strcat "  \"model_entity_count\": " (itoa cnt) ",") fp)
  (write-line "  \"entities\": [" fp)

  (setq i 0)
  (while (< i cnt)
    (setq en (ssname ss i)
          ed (entget en)
          hdl (dxf 5 ed)
          etyp (dxf 0 ed)
          lay (dxf-def 8 ed "0")
          col (dxf-def 62 ed 256)
          tcol (dxf-def 420 ed -1)
          ltyp (dxf-def 6 ed "ByLayer"))

    (write-line "    {" fp)
    (write-line (strcat "      \"handle\": \"" (json-esc hdl) "\",") fp)
    (write-line (strcat "      \"type\": \"" (json-esc etyp) "\",") fp)
    (write-line (strcat "      \"layer\": \"" (json-esc lay) "\",") fp)
    (write-line (strcat "      \"color\": " (itoa col) ",") fp)
    (write-line (strcat "      \"trueColor\": " (itoa tcol) ",") fp)
    (write-line (strcat "      \"linetype\": \"" (json-esc ltyp) "\",") fp)

    (cond
      ((= etyp "LINE")
        (write-line (strcat "      \"start\": " (pt-json (dxf 10 ed)) ",") fp)
        (write-line (strcat "      \"end\": " (pt-json (dxf 11 ed))) fp))

      ((= etyp "LWPOLYLINE")
        (write-line (strcat "      \"closed\": " (if (= (logand (dxf-def 70 ed 0) 1) 1) "true" "false") ",") fp)
        (write-line (strcat "      \"constWidth\": " (num-str (dxf-def 43 ed 0.0)) ",") fp)
        (write-line (strcat "      \"elevation\": " (num-str (dxf-def 38 ed 0.0)) ",") fp)
        (write-line (strcat "      \"vertices\": " (lwpoly-wcs-verts-json en ed)) fp))

      ((= etyp "POLYLINE")
        (write-line (strcat "      \"closed\": " (if (= (logand (dxf-def 70 ed 0) 1) 1) "true" "false") ",") fp)
        (write-line (strcat "      \"vertices\": " (poly-wcs-verts-json en)) fp))

      ((= etyp "MLINE")
        (write-line (strcat "      \"style\": \"" (json-esc (dxf-def 2 ed "")) "\",") fp)
        (write-line (strcat "      \"scale\": " (num-str (dxf-def 40 ed 1.0)) ",") fp)
        (write-line (strcat "      \"vertices\": " (multi-pt-json 11 ed)) fp))

      ((= etyp "CIRCLE")
        (write-line (strcat "      \"center\": " (pt-json (trans (dxf 10 ed) en 0)) ",") fp)
        (write-line (strcat "      \"radius\": " (num-str (dxf 40 ed))) fp))

      ((= etyp "ARC")
        (setq cen (trans (dxf 10 ed) en 0)
              rad (dxf 40 ed)
              sa (dxf 50 ed)
              ea (dxf 51 ed)
              p1 (trans (polar (dxf 10 ed) sa rad) en 0)
              p2 (trans (polar (dxf 10 ed) ea rad) en 0))
        (write-line (strcat "      \"center\": " (pt-json cen) ",") fp)
        (write-line (strcat "      \"radius\": " (num-str rad) ",") fp)
        (write-line (strcat "      \"startAngle\": " (num-str sa) ",") fp)
        (write-line (strcat "      \"endAngle\": " (num-str ea) ",") fp)
        (write-line (strcat "      \"start\": " (pt-json p1) ",") fp)
        (write-line (strcat "      \"end\": " (pt-json p2)) fp))

      ((or (= etyp "TEXT") (= etyp "MTEXT"))
        (write-line (strcat "      \"text\": \"" (json-esc (if (= etyp "MTEXT") (mtext-full-str ed) (dxf-def 1 ed ""))) "\",") fp)
        (write-line (strcat "      \"pos\": " (pt-json (if (= etyp "MTEXT") (dxf 10 ed) (trans (dxf 10 ed) en 0))) ",") fp)
        (write-line (strcat "      \"height\": " (num-str (dxf-def 40 ed 0.0)) ",") fp)
        (write-line (strcat "      \"rotation\": " (num-str (dxf-def 50 ed 0.0))) fp))

      ((= etyp "INSERT")
        (write-line (strcat "      \"name\": \"" (json-esc (dxf-def 2 ed "")) "\",") fp)
        (write-line (strcat "      \"pos\": " (pt-json (trans (dxf 10 ed) en 0)) ",") fp)
        (write-line (strcat "      \"ocsPos\": " (pt-json (dxf 10 ed)) ",") fp)
        (write-line (strcat "      \"scale\": [" (num-str (dxf-def 41 ed 1.0)) "," (num-str (dxf-def 42 ed 1.0)) "," (num-str (dxf-def 43 ed 1.0)) "],") fp)
        (write-line (strcat "      \"rotation\": " (num-str (dxf-def 50 ed 0.0)) ",") fp)
        (write-line (strcat "      \"normal\": " (pt-json (dxf-def 210 ed '(0.0 0.0 1.0))) ",") fp)
        (write-line (strcat "      \"attributes\": " (insert-attribs-json en ed)) fp))

      (t
        (write-line (strcat "      \"pts10\": " (multi-pt-json 10 ed) ",") fp)
        (write-line (strcat "      \"text\": \"" (json-esc (dxf-def 1 ed (dxf-def 304 ed ""))) "\"") fp))
    )

    (if (< i (1- cnt))
      (write-line "    }," fp)
      (write-line "    }" fp)
    )
    (setq i (1+ i))
  )
  (write-line "  ]," fp)

  ;; 3. Block definitions (non-layout)
  (write-line "  \"block_definitions\": [" fp)
  (setq bfirst T
        btbl (tblnext "BLOCK" T))
  (while btbl
    (setq bname (dxf 2 btbl))
    (if (not (wcmatch (strcase bname) "`*MODEL_SPACE,`*PAPER_SPACE*"))
      (progn
        (if (not bfirst) (write-line "," fp))
        (setq bfirst nil
              bhead (tblobjname "BLOCK" bname)
              bed (entget bhead))
        (write-line "    {" fp)
        (write-line (strcat "      \"name\": \"" (json-esc bname) "\",") fp)
        (write-line (strcat "      \"basePoint\": " (pt-json (dxf-def 10 btbl '(0.0 0.0 0.0))) ",") fp)
        (write-line "      \"entities\": [" fp)
        (setq cur (entnext bhead)
              subfirst T)
        (while cur
          (setq ed (entget cur)
                etyp (dxf 0 ed))
          (if (and (/= etyp "VERTEX") (/= etyp "SEQEND"))
            (progn
              (if (not subfirst) (write-line "," fp))
              (setq subfirst nil)
              (princ (strcat "        " (prim-entity-json cur)) fp)
              (if (= etyp "POLYLINE")
                (while (and cur (/= (dxf 0 (entget cur)) "SEQEND"))
                  (setq cur (entnext cur))
                )
              )
            )
          )
          (if cur (setq cur (entnext cur)))
        )
        (write-line "" fp)
        (write-line "      ]" fp)
        (princ "    }" fp)
      )
    )
    (setq btbl (tblnext "BLOCK"))
  )
  (write-line "" fp)
  (write-line "  ]" fp)
  (write-line "}" fp)
  (close fp)
  (princ "\nEXPORT_DONE_OK\n")
  (princ)
)
